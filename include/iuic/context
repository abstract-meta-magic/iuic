#pragma once

#include <algorithm>
#include <cstdint>
#include <memory>
#include <string>
#include <string_view>
#include <variant>
#include <vector>

// Independ User Interface Core
namespace iuic {
using pixel_t = int;

struct position {
  pixel_t x, y = 0;
};

struct size {
  // вместо pixel_t использовать беззнаковое число
  pixel_t w, h = 0;
};

struct ui_rect {
  position position;
  size size;
};

struct text_render_data {};

struct surface_render_data {};

struct frame_render_data {};

struct image_render_data {};

using render_data = std::variant<frame_render_data, surface_render_data,
                                 text_render_data, image_render_data>;

struct relement {
  ui_rect area;      // x,y w,h
  ui_rect clip_area; // простая обрезка
  int z_index;       // слой
  float opacity;     // прозрачность
  render_data data;  // метаданные для отрисовки
};

enum class SurfaceDataType { STR, JSON, XML, YAML, TOML, CSV };

struct surface_create_info {
  std::string type;
  std::string version;
  SurfaceDataType data_type;
  // ну или std::string view или
  // архитектурно storage_ref, рефененс на значение в
  // хранилище
  std::string data;
};

struct text_create_info {
  std::string data;
  std::string font;
  uint32_t size;
};

// родитель берет дочерние объекты и считает свой размер
// если требуется перепросчитываються размеры дочерних объектов

struct image_create_info {};

struct layout {};

struct ui_raw_tree {
  struct node {
    node *parent;
    std::vector<node *> childs;
  };
};
// |A|A-1|A-2|B|B-1|B-1-1|B-2|B-3
// стаил уже должен содержать
// компоновку дочекних элементов
struct style {
  using layout_t = std::unique_ptr<layout> (*)();

  size min_width, min_height, max_width, max_height;

  int margin;

  int padding;

  int border;

  int background;

  int layer;

  layout_t layout; // TODO
};

// что нужно для просчета расположений
// min\max padding(может быть опущен)\margin
// возможно ширина рамки

void compositor(style, int childs);

enum class KeyMod {
  None,
  Alt,
  Shift,
  // ...
};

enum class KeyAction { Down, Up, Hold };

struct ret_t {};

constexpr style def_style{};

class render_tree {};

// макет + стиль + композитор + отрисовка
// build contex and run
// данные можно сохранять в store
// и даже изменять между обновлениями
class context {
public:
  class event_reciver {
  public:
    void key(std::string_view, KeyAction, KeyMod = KeyMod::None){};
    void pointer(position){};
  };
  class builder {
    friend context;

  public:
    /*
      Базовая форма для всего.Стелизуемый рамка.
    */
    template <style st = def_style, typename Call = void>
    void frame(Call call) {
      call(*this);
    };

    /*
      Является конечной точкой.Отрисовка текста
    */
    template <style st = def_style, typename Call = void> void text(Call call) {
      text_create_info info;
      call(*this);
    };

    /*
      Является конечной точкой.Отрисовка изображения
    */
    template <style st = def_style, typename Call = void>
    void image(Call call) {
      image_create_info info;
      call(info);
    };

    /*
      Пользовательская поверхность.
    */
    template <style st = def_style, typename Call = void>
    void surface(Call call) {
      // surface create info
      surface_create_info info;
      call(*this, info);
    };
    ret_t ret() { return {}; };

  private:
    builder(context &ctx);
    // animator
    context &ctx;
  };

public: // api
  void set_view_size(size sz) {
    if (true) { // check for valide size
      view_size = sz;
    }
  };

  template <style st = def_style, typename Call = void> void make(Call call) {
    // do
    call(b);
  };

  render_tree get_tree();

  event_reciver event;

private:
  // event reciver
  // store
  // animator
  size view_size;
  builder b{*this};
};
} // namespace iuic
