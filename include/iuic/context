// flat tree of calculations
struct FTC {
  struct node {
    const style &style;
    relement elament{};
    // 0 - is root
    std::size_t parent;
  };

  void clear() {
    nodes.clear();
    parent = {}; // ...
  };

  void add(const style &style, render_data &&data) {
    auto parent_id = parent.empty() ? 0 : parent.top();
    nodes.push_back(node{style, {.data = std::move(data)}, parent.top()});
    parent.push(nodes.size() - 1);
  };

  void up() { parent.pop(); };

  // TODO: Refactor
  const std::vector<node> &get();

  node &get_current();

private:
  std::vector<node> nodes;
  // current type
  std::stack<std::size_t> parent;
};

