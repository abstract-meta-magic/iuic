// макет + стиль + композитор + отрисовка
// build contex and run
// данные можно сохранять в store
// и даже изменять между обновлениями
class context {
public:
  class animator {};
  class storage {};
  class event_reciver {
  public:
    void key(std::string_view, KeyAction, KeyMod = KeyMod::None){};
    void pointer(position){};
  };
  class builder {
    friend context;

  public:
    /*
      Базовая форма для всего.Стелизуемый рамка.
    */
    template <style st = def_style, typename Call = void>
    void frame(Call call) {
      ctx.calc_tree.add(st, frame_render_data{});
      call(*this);
      ctx.calc_tree.up();
    };

    /*
      Является конечной точкой.Отрисовка текста
    */
    template <style st = def_style, typename Call = void> void text(Call call) {
      ctx.calc_tree.add(st, text_render_data{});
      call(
          std::get<text_render_data>(ctx.calc_tree.get_current().elament.data));
      ctx.calc_tree.up();
    };

    /*
      Является конечной точкой.Отрисовка изображения
    */
    template <style st = def_style, typename Call = void>
    void image(Call call) {
      ctx.calc_tree.add(st, image_render_data{});
      call(std::get<image_render_data>(
          ctx.calc_tree.get_current().elament.data));
      ctx.calc_tree.up();
    };

    /*
      Пользовательская поверхность.
    */
    template <style st = def_style, typename Call = void>
    void surface(Call call) {
      ctx.calc_tree.add(st, surface_render_data{});
      call(*this, std::get<surface_render_data>(
                      ctx.calc_tree.get_current().elament.data));
      ctx.calc_tree.up();
    };

    ret_t ret() { return {}; };

  private:
    builder(context &ctx);
    // animator
    context &ctx;
  };

public: // api
  void set_view_size(size sz) {
    if (true) { // check for valide size
      view_size = sz;
    }
  };

  template <style st = def_style, typename Call = void> void make(Call call) {
    // do
    call(b);

    // построение FTC

    // первый этап вычислений

    // балансировка

    // на его основе построение
    // событий\рендеренга
  };

  render_tree get_tree();

public:
  // event reciver
  event_reciver event;
  // store
  storage storage;

  // animator
  animator animator;

private:
  size view_size;

  // плоское дерево вычислений
  FTC calc_tree;
  // дерево событий
  ET event_tree;
  // плоский список отрисовки
  render_list render_list;
  // ядро построения
  builder b{*this};
};
